{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "siege:hollow_drift",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/hc_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 7
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [6, 3, 6],
        "direction": ["math.random(-1, 1)", "math.random(-0.6, 0.6)", "math.random(-1, 1)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(9, 15)"
      },
      "minecraft:particle_initial_speed": "math.random(0.04, 0.16)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 23 + variable.particle_random_1 * 360) * 0.03",
          "math.sin(variable.particle_age * 17 + variable.particle_random_2 * 360) * 0.02",
          "math.cos(variable.particle_age * 19 + variable.particle_random_3 * 360) * 0.03"
        ],
        "linear_drag_coefficient": 0.15
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.035 + variable.particle_random_4 * 0.05", "0.035 + variable.particle_random_4 * 0.05"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.95,
          0.94,
          0.97,
          "0.8 * math.clamp(math.min(variable.particle_age / 2, (variable.particle_lifetime - variable.particle_age) / 2), 0, 1)"
        ]
      }
    }
  }
}
