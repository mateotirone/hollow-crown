        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.30 + variable.particle_random_2 * 0.1",
          0.22,
          "0.40 + variable.particle_random_2 * 0.12",
          "0.42 * math.clamp(math.min(variable.particle_age / 4, (variable.particle_lifetime - variable.particle_age) / 4), 0, 1)"
