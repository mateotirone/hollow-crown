{
  "format_version": "1.8.0",
  "animations": {
    "animation.siege_family_cart.roll": {
      "loop": true,
      "bones": {
        "wheel_left": { "rotation": ["query.life_time * -110", 0, 0] },
        "wheel_right": { "rotation": ["query.life_time * -110", 0, 0] },
        "load": { "position": [0, "math.abs(math.sin(query.life_time * 400)) * 0.35", 0] }
      }
    },
    "animation.siege_family_cart.sway": {
      "loop": true,
      "bones": {
        "lantern": { "rotation": ["math.sin(query.life_time * 90) * 4", 0, "math.sin(query.life_time * 70) * 3"] }
      }
    }
  }
}
