{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hc_look.first_person": {
      "geometry": "Geometry.hc_look",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.hc_looks[(query.has_property('hc:look') ? query.property('hc:look') : 0) - 1]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "rightSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "leftSleeve": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "rightForearm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "rightForearmSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "leftForearm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "leftForearmSleeve": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        }
      ],
      "arrays": {
        "textures": {
          "Array.hc_looks": [
            "Texture.hc_look_1",
            "Texture.hc_look_2",
            "Texture.hc_look_3",
            "Texture.hc_look_4",
            "Texture.hc_look_5",
            "Texture.hc_look_6",
            "Texture.hc_look_7",
            "Texture.hc_look_8"
          ]
        }
      }
    },
    "controller.render.hc_look.third_person": {
      "geometry": "Geometry.hc_look",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.hc_looks[(query.has_property('hc:look') ? query.property('hc:look') : 0) - 1]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "variable.helmet_layer_visible"
        },
        {
          "leftLegging": "variable.leg_layer_visible"
        },
        {
          "rightLegging": "variable.leg_layer_visible"
        },
        {
          "leftBoot": "variable.boot_layer_visible"
        },
        {
          "rightBoot": "variable.boot_layer_visible"
        },
        {
          "leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "bodyArmor": "variable.chest_layer_visible"
        },
        {
          "leftArmArmor": "variable.chest_layer_visible"
        },
        {
          "rightArmArmor": "variable.chest_layer_visible"
        },
        {
          "belt": "variable.chest_layer_visible && variable.leg_layer_visible"
        }
      ],
      "arrays": {
        "textures": {
          "Array.hc_looks": [
            "Texture.hc_look_1",
            "Texture.hc_look_2",
            "Texture.hc_look_3",
            "Texture.hc_look_4",
            "Texture.hc_look_5",
            "Texture.hc_look_6",
            "Texture.hc_look_7",
            "Texture.hc_look_8"
          ]
        }
      }
    },
    "controller.render.hc_look.map": {
      "geometry": "Geometry.hc_look",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.hc_looks[(query.has_property('hc:look') ? query.property('hc:look') : 0) - 1]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "head": true
        },
        {
          "hat": true
        },
        {
          "helmet": true
        }
      ],
      "arrays": {
        "textures": {
          "Array.hc_looks": [
            "Texture.hc_look_1",
            "Texture.hc_look_2",
            "Texture.hc_look_3",
            "Texture.hc_look_4",
            "Texture.hc_look_5",
            "Texture.hc_look_6",
            "Texture.hc_look_7",
            "Texture.hc_look_8"
          ]
        }
      }
    }
  }
}
