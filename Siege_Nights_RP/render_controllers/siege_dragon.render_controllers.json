{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.siege_dragon": {
   "arrays": {
    "textures": {
     "Array.skins": [
      "Texture.cinderwing",
      "Texture.wyvern",
      "Texture.drake",
      "Texture.wyrm"
     ]
    },
    "geometries": {
     "Array.geos": [
      "Geometry.cinderwing",
      "Geometry.wyvern",
      "Geometry.drake",
      "Geometry.wyrm"
     ]
    }
   },
   "geometry": "Array.geos[query.property('siege:species')]",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.skins[query.property('siege:species')]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "saddle": "query.property('siege:saddled')"
    }
   ]
  }
 }
}