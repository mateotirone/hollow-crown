{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.siege_dragon": {
   "arrays": {
    "textures": {
     "Array.hues": [
      "Texture.ember",
      "Texture.ash",
      "Texture.sand",
      "Texture.obsidian"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.hues[query.property('siege:hue')]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "saddle": "query.property('siege:saddled')"
    }
   ]
  }
 }
}