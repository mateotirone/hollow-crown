{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.siege_steed": {
      "part_visibility": [
        {
          "Saddle": "query.is_saddled"
        },
        {
          "Bit*": "query.is_saddled"
        },
        {
          "Bridle": "query.is_saddled"
        },
        {
          "Reins*": "query.is_saddled && query.has_rider"
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "arrays": {
        "textures": {
          "Array.base": [
            "Texture.base_white",
            "Texture.base_creamy",
            "Texture.base_chestnut",
            "Texture.base_brown",
            "Texture.base_black",
            "Texture.base_gray",
            "Texture.base_darkbrown"
          ],
          "Array.markings": [
            "Texture.markings_none",
            "Texture.markings_white",
            "Texture.markings_whitefield",
            "Texture.markings_whitedots",
            "Texture.markings_blackdots"
          ],
          "Array.armor": [
            "Texture.armor_none",
            "Texture.armor_leather",
            "Texture.armor_iron",
            "Texture.armor_gold",
            "Texture.armor_diamond",
            "Texture.armor_copper",
            "Texture.armor_netherite"
          ],
          "Array.breed": [
            "Texture.markings_none",
            "Texture.coat_vale",
            "Texture.coat_frostmarch",
            "Texture.coat_saltreach",
            "Texture.coat_emberwaste",
            "Texture.coat_blackfen",
            "Texture.coat_crossbred"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.base[query.property('siege:coat')]",
        "query.property('siege:breed') > 0 ? Array.breed[query.property('siege:breed')] : Array.markings[query.property('siege:mark')]",
        "variable.armor_texture_slot ? Array.armor[variable.armor_texture_slot] : (query.property('siege:cap') ? Texture.caparison : (query.property('siege:special') == 1 ? Texture.barding : Texture.armor_none))"
      ],
      "color": {
        "r": "variable.armor_texture_slot ? query.armor_color_slot(4, 0) : (query.property('siege:cap') ? query.property('siege:cap_r') : this)",
        "g": "variable.armor_texture_slot ? query.armor_color_slot(4, 1) : (query.property('siege:cap') ? query.property('siege:cap_g') : this)",
        "b": "variable.armor_texture_slot ? query.armor_color_slot(4, 2) : (query.property('siege:cap') ? query.property('siege:cap_b') : this)",
        "a": "variable.armor_texture_slot ? query.armor_color_slot(4, 3) : this"
      }
    },
    "controller.render.siege_steed_glim": {
      "part_visibility": [
        {
          "Saddle": false
        },
        {
          "Bit*": false
        },
        {
          "Bridle": false
        },
        {
          "Reins*": false
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.ghost"
        }
      ],
      "textures": [
        "Texture.glimstrider"
      ]
    }
  }
}
