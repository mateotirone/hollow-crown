        "hc_sneak": "animation.hc.player.sneak",
        "hc_idle_look": "animation.hc.player.idle_look",
        "hc_idle_shift": "animation.hc.player.idle_shift",
        "hc_idle_stretch": "animation.hc.player.idle_stretch",
        "hc_idle_blade": "animation.hc.player.idle_blade",
        "hc_light_main": "animation.hc.player.light_main",
        "hc_light_off": "animation.hc.player.light_off",
        "hc_read": "animation.hc.player.read",
        "hc_reins": "animation.hc.player.reins",
        "hc_flinch": "animation.hc.player.flinch",
        "everwake_wings": "controller.animation.siege.everwake_wings",
        "everwake_folded": "animation.siege.everwake_wings.folded",
        "everwake_open": "animation.siege.everwake_wings.open",
        "everwake_glide": "animation.siege.everwake_wings.glide",
        "everwake_boost": "animation.siege.everwake_wings.boost",
        "everwake_dive": "animation.siege.everwake_wings.dive",
        "everwake_flare": "animation.siege.everwake_wings.flare"
      },
      "render_controllers": [
        {
          "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator"
        },
        {
          "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator"
        },
        {
          "controller.render.player.first_person": "(variable.is_first_person && !query.is_spectator) && (query.has_property('hc:look') ? query.property('hc:look') : 0) < 1"
        },
        {
          "controller.render.hc_look.first_person": "(variable.is_first_person && !query.is_spectator) && (query.has_property('hc:look') ? query.property('hc:look') : 0) >= 1"
        },
        {
          "controller.render.player.third_person": "(!variable.is_first_person && !variable.map_face_icon && !query.is_spectator) && (query.has_property('hc:look') ? query.property('hc:look') : 0) < 1"
        },
        {
          "controller.render.hc_look.third_person": "(!variable.is_first_person && !variable.map_face_icon && !query.is_spectator) && (query.has_property('hc:look') ? query.property('hc:look') : 0) >= 1"
        },
        {
          "controller.render.player.map": "(variable.map_face_icon) && (query.has_property('hc:look') ? query.property('hc:look') : 0) < 1"
        },
        {
          "controller.render.hc_look.map": "(variable.map_face_icon) && (query.has_property('hc:look') ? query.property('hc:look') : 0) >= 1"
        },
        {
          "controller.render.siege.everwake_wings": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('siege:wings') ? query.property('siege:wings') : 0) >= 1"
        }
      ],
      "enable_attachables": true
    }
  }
}
