{
  "format_version": "1.26.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:player",
      "materials": {
        "default": "entity_alphatest",
        "cape": "entity_alphatest",
        "animated": "player_animated",
        "spectator": "player_spectator",
        "everwake_wings": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/steve",
        "cape": "textures/entity/cape_invisible",
        "hc_look_1": "textures/entity/looks/ulric_thistlewood",
        "hc_look_2": "textures/entity/looks/ridley_icehewer",
        "hc_look_3": "textures/entity/looks/merle_spindrift",
        "hc_look_4": "textures/entity/looks/moss_sedgewick",
        "hc_look_5": "textures/entity/looks/farron_sandys",
        "hc_look_6": "textures/entity/looks/hawise_barleycorn",
        "hc_look_7": "textures/entity/looks/bram_meadows",
        "hc_look_8": "textures/entity/looks/ridley_stagg",
        "everwake_wings": "textures/entity/everwake_wings"
      },
      "geometry": {
        "default": "geometry.humanoid.custom",
        "cape": "geometry.cape",
        "hc_look": "geometry.hc.jointed",
        "everwake_wings": "geometry.siege.everwake_wings"
      },
      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "variable.is_holding_right = 0.0;",
          "variable.is_blinking = 0.0;",
          "variable.last_blink_time = 0.0;",
          "variable.hand_bob = 0.0;",
          "variable.melee_spear_equipped = 0.0;",
          "variable.hc_last_t = 0.0;",
          "variable.hc_combo = 0.0;",
          "variable.hc_swing_at = -10.0;",
          "variable.hc_kind = 0.0;",
          "variable.hc_draw_start = 0.0;",
          "variable.hc_was_drawing = 0.0;",
          "variable.hc_release_at = -10.0;",
          "variable.hc_release_pow = 0.0;",
          "variable.hc_sprint = 0.0;",
          "variable.hc_airb = 0.0;",
          "variable.hc_was_air = 0.0;",
          "variable.hc_air_start = 0.0;",
          "variable.hc_land_at = -10.0;",
          "variable.hc_land_pow = 0.0;",
          "variable.hc_freeb = 1.0;",
          "variable.hc_idle_for = 0.0;"
        ],
        "pre_animation": [
          "variable.helmet_layer_visible = !query.has_head_gear;",
          "variable.leg_layer_visible = 1.0;",
          "variable.boot_layer_visible = 1.0;",
          "variable.chest_layer_visible = 1.0;",
          "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
          "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
          "variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
          "variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
          "variable.riding_y_offset = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat', 'minecraft:strider') ? -3.0 : 0.0;",
          "variable.hc_heavy = query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.mainhand', 0, 'siege:warhammer', 'siege:choirsteel_axe', 'minecraft:mace', 'minecraft:wooden_axe', 'minecraft:stone_axe', 'minecraft:copper_axe', 'minecraft:iron_axe', 'minecraft:golden_axe', 'minecraft:diamond_axe', 'minecraft:netherite_axe') : 0.0;",
          "variable.hc_blade = query.has_property('hc:look') ? (query.is_item_name_any('slot.weapon.mainhand', 0, 'siege:longsword', 'siege:minute_hand', 'siege:warlords_brand', 'siege:oath_of_oswin', 'siege:choirsteel_sword', 'minecraft:wooden_sword', 'minecraft:stone_sword', 'minecraft:copper_sword', 'minecraft:iron_sword', 'minecraft:golden_sword', 'minecraft:diamond_sword', 'minecraft:netherite_sword') || query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_sword')) : 0.0;",
          "variable.hc_weapon = !(query.has_property('hc:look') ? query.is_item_equipped(0) : 1.0) ? 3.0 : (variable.hc_heavy ? 2.0 : (variable.hc_blade ? 1.0 : 0.0));",
          "variable.hc_rimefang = query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.mainhand', 0, 'siege:rimefang_bow') : 0.0;",
          "variable.hc_bow = variable.hc_rimefang || (query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:bow') : 0.0);",
          "variable.hc_light_main = query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:torch', 'minecraft:soul_torch', 'minecraft:copper_torch', 'minecraft:lantern', 'minecraft:soul_lantern', 'minecraft:redstone_torch') : 0.0;",
          "variable.hc_light_off = query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.offhand', 0, 'minecraft:torch', 'minecraft:soul_torch', 'minecraft:copper_torch', 'minecraft:lantern', 'minecraft:soul_lantern', 'minecraft:redstone_torch') : 0.0;",
          "variable.hc_book = query.has_property('hc:look') ? query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:book', 'minecraft:writable_book', 'minecraft:written_book', 'minecraft:enchanted_book', 'siege:almanac', 'siege:kings_journal', 'siege:lore_tome', 'siege:ledger', 'siege:fourteen_arts') : 0.0;",
          "variable.hc_read = variable.hc_book && variable.attack_time <= 0.0 && !query.is_riding ? 1.0 - math.min(query.modified_move_speed * 2.5, 0.6) : 0.0;",
          "variable.hc_t = math.clamp(variable.attack_time, 0.0, 1.0);",
          "variable.hc_new_swing = variable.attack_time > 0.0 && (variable.hc_last_t <= 0.0 || variable.attack_time < variable.hc_last_t);",
          "variable.hc_combo = variable.hc_new_swing ? ((query.life_time - variable.hc_swing_at > 1.2) ? 0.0 : math.mod(variable.hc_combo + 1.0, 3.0)) : variable.hc_combo;",
          "variable.hc_swing_at = variable.hc_new_swing ? query.life_time : variable.hc_swing_at;",
          "variable.hc_kind = variable.hc_new_swing ? variable.hc_weapon : variable.hc_kind;",
          "variable.hc_last_t = variable.attack_time;",
          "variable.hc_r = math.clamp((variable.hc_t - 0.65) / 0.35, 0.0, 1.0);",
          "variable.hc_e = variable.attack_time > 0.0 ? math.sin(math.min(variable.hc_t / 0.2, 1.0) * 90.0) * (1.0 - variable.hc_r * variable.hc_r * (3.0 - 2.0 * variable.hc_r)) : 0.0;",
          "variable.hc_q = math.clamp((variable.hc_t - 0.2) / 0.35, 0.0, 1.0);",
          "variable.hc_s = variable.hc_q * variable.hc_q * (3.0 - 2.0 * variable.hc_q);",
          "variable.hc_drawing = variable.hc_bow && variable.item_use_normalized > 0.0 && variable.item_use_normalized < 1.0;",
          "variable.hc_draw_start = (variable.hc_drawing && !variable.hc_was_drawing) ? query.life_time : variable.hc_draw_start;",
          "variable.hc_release_pow = (!variable.hc_drawing && variable.hc_was_drawing) ? math.clamp(query.life_time - variable.hc_draw_start, 0.0, 1.0) : variable.hc_release_pow;",
          "variable.hc_release_at = (!variable.hc_drawing && variable.hc_was_drawing) ? query.life_time : variable.hc_release_at;",
          "variable.hc_was_drawing = variable.hc_drawing;",
          "variable.hc_draw = variable.hc_drawing ? math.clamp(query.life_time - variable.hc_draw_start, 0.0, 1.0) : 0.0;",
          "variable.hc_shake = variable.hc_drawing ? math.clamp((query.life_time - variable.hc_draw_start - 1.5) / 3.0, 0.0, 1.0) : 0.0;",
          "variable.hc_release = (variable.hc_release_pow > 0.3 && variable.hc_bow) ? math.clamp(1.0 - (query.life_time - variable.hc_release_at) / 0.35, 0.0, 1.0) * variable.hc_release_pow : 0.0;",
          "variable.hc_in_air = !query.is_on_ground && !query.is_riding && !query.is_in_water && variable.swim_amount <= 0.0 && !query.is_gliding && (query.has_property('siege:wings') ? query.property('siege:wings') < 2 : 1);",
          "variable.hc_landed = !variable.hc_in_air && variable.hc_was_air && query.life_time - variable.hc_air_start > 0.35;",
          "variable.hc_land_pow = variable.hc_landed ? math.clamp((query.life_time - variable.hc_air_start) / 1.2, 0.35, 1.0) : variable.hc_land_pow;",
          "variable.hc_land_at = variable.hc_landed ? query.life_time : variable.hc_land_at;",
          "variable.hc_air_start = (variable.hc_in_air && !variable.hc_was_air) ? query.life_time : variable.hc_air_start;",
          "variable.hc_was_air = variable.hc_in_air;",
          "variable.hc_land = variable.hc_land_pow * math.clamp(1.0 - (query.life_time - variable.hc_land_at) / 0.3, 0.0, 1.0);",
          "variable.hc_k = math.min(1.0, query.delta_time * 8.0);",
          "variable.hc_sprint = variable.hc_sprint + ((query.is_sprinting && query.is_on_ground && !query.is_riding) - variable.hc_sprint) * variable.hc_k;",
          "variable.hc_airb = variable.hc_airb + ((variable.hc_in_air && (query.vertical_speed > 3.0 || query.life_time - variable.hc_air_start > 0.15)) - variable.hc_airb) * math.min(1.0, query.delta_time * 14.0);",
          "variable.hc_fall = math.clamp((-query.vertical_speed - 4.0) / 16.0, 0.0, 1.0);",
          "variable.hc_rise = variable.hc_airb * math.clamp(query.vertical_speed / 6.0, 0.0, 1.0);",
          "variable.hc_tuck = variable.hc_airb * math.clamp(1.0 - math.abs(query.vertical_speed) / 6.0, 0.0, 1.0) * (1.0 - variable.hc_fall);",
          "variable.hc_freeb = variable.hc_freeb + ((variable.attack_time <= 0.0 && !variable.hc_drawing && !query.blocking && variable.hc_release <= 0.0) - variable.hc_freeb) * math.min(1.0, query.delta_time * 12.0);",
          "variable.hc_free = variable.hc_freeb;",
          "variable.hc_live = !query.is_sleeping && !query.is_emoting && !query.is_riding && !query.is_crawling && variable.swim_amount <= 0.0;",
          "variable.hc_freel = variable.hc_freeb * (1.0 - variable.hc_light_off);",
          "variable.hc_still = variable.hc_live && query.is_on_ground && query.modified_move_speed < 0.02 && variable.attack_time <= 0.0 && !variable.hc_drawing && !query.is_sneaking && variable.hc_read <= 0.0;",
          "variable.hc_idle_for = variable.hc_still ? variable.hc_idle_for + query.delta_time : 0.0;",
          "variable.hc_fidt = math.mod(math.max(variable.hc_idle_for - 6.0, 0.0), 7.0);",
          "variable.hc_fidk = math.mod(math.floor(math.max(variable.hc_idle_for - 6.0, 0.0) / 7.0), 3.0);",
          "variable.hc_fid = variable.hc_idle_for > 6.0 ? math.sin(variable.hc_fidt / 7.0 * 180.0) : 0.0;",
          "variable.hc_mounted = query.is_riding && (query.has_property('hc:look') ? query.is_riding_any_entity_of_type('minecraft:horse', 'minecraft:donkey', 'minecraft:mule', 'minecraft:skeleton_horse', 'minecraft:zombie_horse', 'minecraft:camel', 'siege:steed', 'siege:dragon') : 0.0);",
          "variable.hc_hurt = math.clamp(query.hurt_time / 10.0, 0.0, 1.0);"
        ],
        "animate": [
          "root",
          "everwake_wings",
          "hc_actions"
        ],
        "variables": {
          "variable.fp_melee_spear_use_attachable_rotation_z": "public",
          "variable.tp_melee_spear_use_attachable_rotation_z": "public",
          "variable.fp_melee_spear_attack_attachable_rotation_z": "public",
          "variable.tp_melee_spear_attack_attachable_position_z": "public",
          "variable.attack_time": "public",
          "variable.item_use_normalized": "public",
          "variable.melee_spear_equipped": "public"
        },
        "should_update_effects_offscreen": "1.0"
      },
      "animations": {
        "root": "controller.animation.player.root",
