{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "siege:archer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "c0": "textures/entity/siege/archer_white",
        "c1": "textures/entity/siege/archer_orange",
        "c2": "textures/entity/siege/archer_magenta",
        "c3": "textures/entity/siege/archer_light_blue",
        "c4": "textures/entity/siege/archer_yellow",
        "c5": "textures/entity/siege/archer_lime",
        "c6": "textures/entity/siege/archer_pink",
        "c7": "textures/entity/siege/archer_gray",
        "c8": "textures/entity/siege/archer_light_gray",
        "c9": "textures/entity/siege/archer_cyan",
        "c10": "textures/entity/siege/archer_purple",
        "c11": "textures/entity/siege/archer_blue",
        "c12": "textures/entity/siege/archer_brown",
        "c13": "textures/entity/siege/archer_green",
        "c14": "textures/entity/siege/archer_red",
        "c15": "textures/entity/siege/archer_black"
      },
      "geometry": {
        "default": "geometry.humanoid.custom"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / 1.0) * 57.3;",
          "variable.hc_mv = math.min(query.modified_move_speed * 4.0, 1.0);",
          "variable.hc_rdy = math.lerp(variable.hc_rdy ?? 0.0, query.has_target ? 1.0 : 0.0, 0.12);",
          "variable.hc_wind = variable.attack_time > 0.0 ? math.clamp(variable.attack_time / 0.3, 0.0, 1.0) : 0.0;",
          "variable.hc_strike = variable.attack_time > 0.3 ? math.clamp((variable.attack_time - 0.3) / 0.4, 0.0, 1.0) : 0.0;",
          "variable.hc_draw = math.clamp(math.mod(query.life_time, 2.0) / 1.5, 0.0, 1.0);"
        ],
        "animate": [
          "humanoid_base_pose",
          "look_at_target_default",
          "holding",
          "hc_march",
          "hc_idle",
          {
            "bow_and_arrow": "query.has_target"
          },
          {
            "hc_aim": "query.has_target"
          },
          {
            "hc_hurt": "query.hurt_time > 0"
          }
        ]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "holding": "animation.humanoid.holding",
        "hc_march": "animation.hc.guard.march",
        "hc_idle": "animation.hc.guard.idle",
        "hc_hurt": "animation.hc.guard.hurt",
        "hc_salute": "animation.hc.guard.salute",
        "bow_and_arrow": "animation.humanoid.bow_and_arrow",
        "hc_aim": "animation.hc.guard.aim"
      },
      "render_controllers": [
        "controller.render.siege_guard"
      ],
      "enable_attachables": true
    }
  }
}
