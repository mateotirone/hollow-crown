{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "siege:oath_tree",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "siege:look": {
          "type": "int",
          "range": [0, 2],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "siege:grown": {
        "minecraft:scale": { "value": 1.5 },
        "minecraft:collision_box": { "width": 1.4, "height": 6 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["oath_tree", "inanimate"] },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:collision_box": { "width": 1, "height": 4 },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:knockback_resistance": { "value": 1 },
      "minecraft:movement": { "value": 0 },
      "minecraft:persistent": {},
      "minecraft:fire_immune": {},
      "minecraft:breathable": { "breathes_water": true, "breathes_air": true, "suffocate_time": -1 },
      "minecraft:damage_sensor": { "triggers": [{ "deals_damage": "no" }] }
    },
    "events": {
      "siege:grow": { "add": { "component_groups": ["siege:grown"] } },
      "siege:shrink": { "remove": { "component_groups": ["siege:grown"] } }
    }
  }
}
