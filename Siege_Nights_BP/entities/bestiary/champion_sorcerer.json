{
 "format_version": "1.21.60",
 "minecraft:entity": {
  "description": {
   "identifier": "siege:champion_sorcerer",
   "is_spawnable": true,
   "is_summonable": true,
   "is_experimental": false
  },
  "component_groups": {
   "siege:stance_hostile": {
    "minecraft:behavior.nearest_attackable_target": {
     "priority": 2,
     "must_see": false,
     "reselect_targets": true,
     "within_radius": 32,
     "entity_types": [
      {
       "filters": {
        "any_of": [
         {
          "test": "is_family",
          "subject": "other",
          "operator": "==",
          "value": "player"
         },
         {
          "test": "is_family",
          "subject": "other",
          "operator": "==",
          "value": "siege_guard"
         }
        ]
       },
       "max_dist": 32
      }
     ]
    }
   },
   "siege:stance_realm": {
    "minecraft:behavior.nearest_attackable_target": {
     "priority": 2,
     "must_see": false,
     "reselect_targets": true,
     "within_radius": 20,
     "entity_types": [
      {
       "filters": {
        "all_of": [
         {
          "test": "is_family",
          "subject": "other",
          "operator": "==",
          "value": "monster"
         },
         {
          "test": "is_family",
          "subject": "other",
          "operator": "!=",
          "value": "creeper"
         }
        ]
       },
       "max_dist": 20
      }
     ]
    }
   },
   "siege:bow": {
    "minecraft:is_charged": {}
   },
   "siege:guard": {
    "minecraft:is_saddled": {}
   },
   "siege:drink": {
    "minecraft:is_ignited": {}
   }
  },
  "components": {
   "minecraft:type_family": {
    "family": [
     "mob",
     "siege_champion"
    ]
   },
   "minecraft:health": {
    "value": 64,
    "max": 64
   },
   "minecraft:collision_box": {
    "width": 0.6,
    "height": 1.9
   },
   "minecraft:nameable": {},
   "minecraft:physics": {},
   "minecraft:pushable": {
    "is_pushable": true,
    "is_pushable_by_piston": true
   },
   "minecraft:knockback_resistance": {
    "value": 0.5
   },
   "minecraft:damage_sensor": {
    "triggers": [
     {
      "on_damage": {
       "filters": {
        "test": "has_tag",
        "subject": "self",
        "value": "siege_champ_guard"
       }
      },
      "cause": "entity_attack",
      "damage_multiplier": 0.15
     },
     {
      "on_damage": {
       "filters": {
        "test": "has_tag",
        "subject": "self",
        "value": "siege_champ_guard"
       }
      },
      "cause": "projectile",
      "deals_damage": "no"
     },
     {
      "cause": "fall",
      "damage_multiplier": 0.4
     }
    ]
   },
   "minecraft:movement": {
    "value": 0.3
   },
   "minecraft:experience_reward": {
    "on_death": "query.last_hit_by_player ? 16 : 0"
   },
   "minecraft:behavior.look_at_player": {
    "priority": 8,
    "look_distance": 8
   },
   "minecraft:behavior.random_look_around": {
    "priority": 9
   },
   "minecraft:behavior.hurt_by_target": {
    "priority": 1,
    "alert_same_type": false
   },
   "minecraft:navigation.walk": {
    "can_path_over_water": true,
    "avoid_water": true,
    "can_open_doors": true,
    "can_pass_doors": true,
    "avoid_damage_blocks": true
   },
   "minecraft:movement.basic": {},
   "minecraft:jump.static": {},
   "minecraft:behavior.float": {
    "priority": 0
   },
   "minecraft:behavior.random_stroll": {
    "priority": 7,
    "speed_multiplier": 0.8
   },
   "minecraft:attack": {
    "damage": 5
   },
   "minecraft:behavior.melee_attack": {
    "priority": 3,
    "speed_multiplier": 1.25,
    "track_target": true
   },
   "minecraft:persistent": {},
   "minecraft:loot": {
    "table": "loot_tables/entities/bestiary/champion_sorcerer.json"
   }
  },
  "events": {
   "siege:hostile": {
    "remove": {
     "component_groups": [
      "siege:stance_realm"
     ]
    },
    "add": {
     "component_groups": [
      "siege:stance_hostile"
     ]
    }
   },
   "siege:realm": {
    "remove": {
     "component_groups": [
      "siege:stance_hostile"
     ]
    },
    "add": {
     "component_groups": [
      "siege:stance_realm"
     ]
    }
   },
   "siege:calm": {
    "remove": {
     "component_groups": [
      "siege:stance_hostile",
      "siege:stance_realm"
     ]
    }
   },
   "siege:bow_on": {
    "add": {
     "component_groups": [
      "siege:bow"
     ]
    }
   },
   "siege:bow_off": {
    "remove": {
     "component_groups": [
      "siege:bow"
     ]
    }
   },
   "siege:guard_on": {
    "add": {
     "component_groups": [
      "siege:guard"
     ]
    }
   },
   "siege:guard_off": {
    "remove": {
     "component_groups": [
      "siege:guard"
     ]
    }
   },
   "siege:drink_on": {
    "add": {
     "component_groups": [
      "siege:drink"
     ]
    }
   },
   "siege:drink_off": {
    "remove": {
     "component_groups": [
      "siege:drink"
     ]
    }
   }
  }
 }
}