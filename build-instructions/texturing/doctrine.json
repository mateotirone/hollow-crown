{
  "version": 1,
  "about": "The texturing doctrine (Mateo, 2026-11-11): region > colour family with a code > a ladder of blocks. Edit this file, then run build_doctrine.py to rebuild the region pages and the viewer.",
  "rules": {
    "max_blocks_per_surface": 3,
    "max_blocks_big_surface": 5,
    "big_surface": "walls longer than 15 or taller than 9, and civic buildings",
    "base_share_min": 0.6,
    "ladder_order": "dark to light by value unless 'order' says otherwise",
    "no_skipped_steps": "neighbouring cells differ by at most one ladder step",
    "clusters": "low-frequency noise, cells of about 3 to 7 blocks, never single-block speckle",
    "cracks": "corners, openings, where planes meet; darkest part of the gradient",
    "walls": "vertical surfaces use paint_teeth: bands bottom to top, edges interlocking in columns 1 to 2 rows deep, a few lone blocks ahead of each edge",
    "texture_along_ladder": "texture may change along a ladder (bricks low, cobble, then smoother stone up top) as long as lightness climbs; colour may shift only across a real material change (stone to earth)"
  },
